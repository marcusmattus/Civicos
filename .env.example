# ---------------------------------------------------------------------------
# CivicOS environment
#
# Every variable is OPTIONAL. With none of them set the app runs in DEMO MODE:
# authentication is mocked and all data is served from the seeded in-memory
# store, so `npm run dev` works with zero configuration.
# ---------------------------------------------------------------------------

# --- Firebase (client SDK) -------------------------------------------------
# Set all six to switch authentication from the mock provider to Firebase Auth.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated email domains permitted to sign in (empty = allow all).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=gov.uk,london.gov.uk,nhs.net

# --- Firestore persistence (server) ----------------------------------------
# When set, API routes persist simulations, audit entries and evidence to
# Firestore instead of the in-memory store.
CIVICOS_PERSISTENCE=memory   # memory | firestore
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Replaceable upstream services -----------------------------------------
# Point these at the real FastAPI / Hugging Face / simulation endpoints when
# they exist; unset means the built-in mock engine is used.
CIVICOS_SIMULATION_API_URL=
CIVICOS_SIMULATION_API_KEY=
CIVICOS_FORECAST_MODEL_URL=
CIVICOS_FORECAST_MODEL_KEY=

# --- Run engine tuning ------------------------------------------------------
# Milliseconds between simulated agent progress ticks.
CIVICOS_RUN_TICK_MS=350
